# ---------- Server ----------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
# Replace USER and PASSWORD with your PostgreSQL username and password.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/inuka

# ---------- Authentication ----------
# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
# Students must confirm their email before first sign-in (spec 15.2). Set to false to skip while testing.
REQUIRE_EMAIL_VERIFICATION=true
# "Sign in with Google" (optional). Create an OAuth client ID of type "Web application" in Google Cloud Console
# (APIs & Services > Credentials) and add http://localhost:5173 to "Authorised JavaScript origins".
# Under "Authorised redirect URIs" add http://localhost:5173/api/auth/google/callback (and later your real address).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if your redirect address is different from FRONTEND_URL + /api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------- Seed admin account ----------
SEED_ADMIN_EMAIL=admin@inuka.app
SEED_ADMIN_PASSWORD=ChangeMe123
# Test student and mentor accounts (created only when NODE_ENV is not production)
SEED_STUDENT_EMAIL=student@inuka.app
SEED_STUDENT_PASSWORD=ChangeMe123
SEED_MENTOR_EMAIL=mentor@inuka.app
SEED_MENTOR_PASSWORD=ChangeMe123

# ---------- File storage ----------
# "local" saves uploads to backend/uploads (development). "s3" is added in a later phase.
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=inuka-documents

# ---------- OpenAI (later phase) ----------
OPENAI_API_KEY=

# ---------- Email ----------
# Leave SENDGRID_API_KEY empty in development: emails are printed in the backend console.
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@inuka.app
# Where messages from the home page "Submit your query" form are emailed (they are also saved for the admin).
CONTACT_EMAIL=

# ---------- Scholarship API (later phase) ----------
SCHOLARSHIP_API_KEY=

# ---------- INUKA AI (spec 13) ----------
# FREE options:
#   gemini  — Google Gemini free tier. Key: https://aistudio.google.com/apikey   (recommended to start)
#   groq    — Groq free tier (Llama models). Key: https://console.groq.com/keys
#   ollama  — free and private, runs on your own computer/server (https://ollama.com). No key needed.
# Paid options: openai (GPT-4o, as in the spec) or anthropic (Claude).
# Leave AI_PROVIDER and AI_API_KEY empty to switch the assistant off.
AI_PROVIDER=gemini
AI_API_KEY=
# Optional: a different model (defaults: gemini-3.5-flash, llama-3.3-70b-versatile, llama3.2, gpt-4o, claude-haiku-4-5-20251001)
AI_MODEL=
# Optional: a different address (e.g. Ollama on another machine: http://192.168.1.20:11434/v1)
AI_BASE_URL=

# Time zone used for dates in emails (mentor sessions)
APP_TIMEZONE=Africa/Kigali

