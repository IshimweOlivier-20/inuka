# ---------- Server ----------
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Replace USER and PASSWORD with your PostgreSQL username and password.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/inuka

# ---------- Authentication ----------
# Use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7
# Students must confirm their email before first sign-in (spec 15.2). Set to false to skip while testing.
REQUIRE_EMAIL_VERIFICATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Seed admin account ----------
SEED_ADMIN_EMAIL=admin@inuka.app
SEED_ADMIN_PASSWORD=ChangeMe123

# ---------- File storage ----------
# "local" saves uploads to server/uploads (development). "s3" is added in a later phase.
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=inuka-documents

# ---------- OpenAI (later phase) ----------
OPENAI_API_KEY=

# ---------- Email ----------
# Leave SENDGRID_API_KEY empty in development: emails are printed in the server console.
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@inuka.app

# ---------- Scholarship API (later phase) ----------
SCHOLARSHIP_API_KEY=
